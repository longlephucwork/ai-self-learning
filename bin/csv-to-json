#!/usr/bin/env python3
# learning-harness usage wrapper for the installed script 'csv-to-json' (v1).
# Generated by registry/install.py (harness code, not learned code). It runs the
# script unchanged, then appends ONE line to store/usage/csv-to-json.jsonl:
# time, exit code, duration, version, and whether Claude Code ran it (with its
# session id). It never records arguments, file contents or output.
import json, os, subprocess, sys, time
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
ENTRY = os.path.join(ROOT, 'scripts/csv-to-json/csv_to_json.py')
t0 = time.time()
rc = subprocess.call([sys.executable, ENTRY] + sys.argv[1:])
try:
    store = os.environ.get("LEARNING_HARNESS_STORE") or os.path.join(ROOT, "store")
    os.makedirs(os.path.join(store, "usage"), exist_ok=True)
    rec = {"name": 'csv-to-json', "version": 1, "at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
           "exit": rc, "duration_ms": int((time.time() - t0) * 1000),
           "via": "claude" if os.environ.get("CLAUDECODE") == "1" else "terminal",
           "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID")}
    fd = os.open(os.path.join(store, "usage", 'csv-to-json' + ".jsonl"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.write(fd, (json.dumps(rec) + "\n").encode())
    os.close(fd)
except Exception:
    pass  # logging must never break the script
sys.exit(rc)
